DATABASE_URL="postgresql://chosica:chosica@localhost:5432/chosica?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3000

# Storage de fotos (S3-compatible). Estos valores son para el MinIO local
# de docker-compose.yml; para AWS S3 real dejar S3_ENDPOINT vacío,
# S3_FORCE_PATH_STYLE=false, y usar las credenciales/region reales.
S3_ENDPOINT="http://localhost:9000"
S3_FORCE_PATH_STYLE=true
S3_REGION="us-east-1"
S3_BUCKET="chosica-photos"
S3_ACCESS_KEY_ID="chosica"
S3_SECRET_ACCESS_KEY="chosica123"
# URL publica desde la que se sirven las fotos (el bucket debe ser publico
# de lectura). Con MinIO local vía path-style es "<endpoint>/<bucket>".
# OJO: esta URL la usa el CELULAR, no el backend — igual que
# EXPO_PUBLIC_API_URL en mobile/.env, "localhost" acá NO sirve (apunta al
# propio celular). Usar la IP LAN del servidor, ej "http://192.168.0.200:9000/chosica-photos".
S3_PUBLIC_BASE_URL="http://localhost:9000/chosica-photos"

# Notificaciones push (Firebase Cloud Messaging). El JSON completo de la
# cuenta de servicio (Firebase Console -> Configuracion del proyecto ->
# Cuentas de servicio -> Generar nueva clave privada), minificado a una
# sola linea entre comillas simples. Sin esta variable, NotificationsService
# no rompe nada -- queda en modo no-op (solo loguea, no manda pushes).
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
