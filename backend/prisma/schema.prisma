generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  username        String     @unique
  passwordHash    String
  // Rol de moderacion basico: sin panel admin todavia, se activa a mano
  // con un UPDATE en la base de datos (ver ROADMAP.md).
  isModerator     Boolean    @default(false)
  // Preferencia de feed (brief seccion 18, "categorias que el usuario
  // siga"): un array nativo de Postgres alcanza, no hace falta una tabla
  // de union para esto.
  followedCategories PostCategory[] @default([])
  createdAt       DateTime   @default(now())
  posts           Post[]
  businessesCreated Business[] @relation("BusinessCreatedBy")
  businessesOwned   Business[] @relation("BusinessOwner")
  businessClaimsMade     BusinessClaim[] @relation("BusinessClaimsMade")
  businessClaimsReviewed BusinessClaim[] @relation("BusinessClaimsReviewed")
  comments        Comment[]
  reactions       Reaction[]
  reportsMade     Report[]   @relation("ReportsMade")
  reportsReviewed Report[]   @relation("ReportsReviewed")
  photos          Photo[]
  following       Follow[]   @relation("Following")
  followers       Follow[]   @relation("Followers")
  savedItems      SavedItem[]
}

enum PostCategory {
  ACCIDENTE
  INCIDENTE
  ANIMAL_PERDIDO
  ANIMAL_ENCONTRADO
  ADOPCION
  RECOMENDACION
  EVENTO
  AVISO
  VENTA
  OTRO
}

// lat/lng son la fuente de verdad; la columna "geog" (geography(Point,4326))
// se agrega vía prisma/postgis-extensions.sql porque Prisma no modela tipos PostGIS.
model Post {
  id          String       @id @default(uuid())
  category    PostCategory
  title       String
  description String?
  lat         Float
  lng         Float
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  locationId  String?
  location    Location?    @relation(fields: [locationId], references: [id])
  comments    Comment[]
  reactions   Reaction[]
  reports     Report[]
  // Oculto por moderacion (ver Report). Los endpoints publicos lo excluyen.
  hidden      Boolean      @default(false)
  // Null = permanente (recomendaciones, avisos sin vencimiento, etc.).
  // Categorias que decaen (ACCIDENTE/INCIDENTE) reciben un valor por
  // defecto al crearse (ver DEFAULT_TTL_HOURS en posts.service.ts) si el
  // usuario no manda uno explicito; EVENTO usa la fecha del evento. Los
  // negocios/lugares (Business) son permanentes por diseño y no tienen
  // este campo — no hace falta, viven en otra tabla.
  expiresAt   DateTime?
  // 1:1 opcional: solo existe cuando category es de animales o EVENTO
  // respectivamente (validado en posts.service.ts, no en el esquema).
  animalDetails AnimalDetails?
  eventDetails  EventDetails?
  saleDetails   SaleDetails?
  photos      Photo[]
  savedBy     SavedItem[]
  createdAt   DateTime     @default(now())

  @@index([category])
  @@index([createdAt])
  @@index([locationId])
  @@index([expiresAt])
}

enum AnimalSpecies {
  PERRO
  GATO
  AVE
  OTRO
}

enum AnimalSex {
  MACHO
  HEMBRA
  DESCONOCIDO
}

// Extension 1:1 de Post para ANIMAL_PERDIDO / ANIMAL_ENCONTRADO / ADOPCION.
// El post ya aporta ubicacion, fecha/hora (createdAt), comentarios,
// reacciones y reportes; aca solo van los campos propios del animal
// (seccion 9 del brief). adoptionConditions solo tiene sentido si el post
// es de categoria ADOPCION.
model AnimalDetails {
  postId             String        @id
  post               Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  species            AnimalSpecies
  petName            String?
  color              String?
  characteristics    String?
  sex                AnimalSex?
  approxAgeYears     Float?
  adoptionConditions String?
  contactPhone       String?
}

// Extension 1:1 de Post para EVENTO (seccion 12 del brief). startsAt es la
// fecha/hora real del evento; si el post no trae "expiresAt" propio, el
// servicio usa startsAt como vencimiento (el evento deja de listarse
// cuando ya paso). Nombre/descripcion/ubicacion ya los da Post.
model EventDetails {
  postId        String   @id
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  organizerName String?
}

enum SaleCondition {
  NUEVO
  USADO
}

// Extension 1:1 de Post para VENTA (seccion 13 del brief). Fotos, titulo,
// descripcion, ubicacion y vendedor ya los da Post — aca solo precio y lo
// que es propio de un anuncio de venta. Precio como Decimal (no Float):
// es dinero, no queremos errores de redondeo en punto flotante.
model SaleDetails {
  postId    String        @id
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  price     Decimal       @db.Decimal(10, 2)
  currency  String        @default("PEN")
  condition SaleCondition?
  sold      Boolean       @default(false)
}

enum LocationType {
  PAIS
  REGION
  PROVINCIA
  DISTRITO
  ZONA
}

// Jerarquia geografica generica (Peru > Lima > Lima > Lurigancho-Chosica > Chosica)
// como una sola tabla auto-referenciada: agregar un distrito o ciudad nueva
// mas adelante es insertar una fila, no una migracion.
model Location {
  id        String       @id @default(uuid())
  type      LocationType
  name      String
  parentId  String?
  parent    Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children  Location[]   @relation("LocationHierarchy")
  posts     Post[]
  businesses Business[]
  createdAt DateTime     @default(now())

  @@index([parentId])
  @@index([type])
}

enum BusinessCategory {
  RESTAURANTE
  TIENDA
  HOSTAL
  PARQUE
  TURISMO
  FARMACIA
  SALUD
  EDUCACION
  BANCO_CAJERO
  PARADA
  OTRO
}

// Directorio de negocios/lugares. "geog" (geography(Point,4326) + indice
// GIST) se agrega en prisma/postgis-extensions.sql, igual que en Post.
// createdById es quien dio de alta el lugar (cualquier usuario, como en
// OSM/Google Maps) y sigue pudiendo editarlo mientras nadie lo reclame.
// ownerId es el dueño verificado (ver BusinessClaim): una vez asignado,
// solo el/la owner puede editar, no ya cualquiera que haya sido
// createdById.
model Business {
  id          String           @id @default(uuid())
  category    BusinessCategory
  name        String
  description String?
  address     String?
  phone       String?
  hours       String?
  lat         Float
  lng         Float
  locationId  String?
  location    Location?        @relation(fields: [locationId], references: [id])
  createdById String
  createdBy   User             @relation("BusinessCreatedBy", fields: [createdById], references: [id])
  ownerId     String?
  owner       User?            @relation("BusinessOwner", fields: [ownerId], references: [id])
  verified    Boolean          @default(false)
  claims      BusinessClaim[]
  comments    Comment[]
  reactions   Reaction[]
  reports     Report[]
  photos      Photo[]
  hidden      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
  @@index([locationId])
}

enum BusinessClaimStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Solicitud de un usuario para convertirse en dueño verificado de un
// negocio ya cargado (por otra persona o por si mismo, via OSM-style).
// Al aprobarse (PATCH /business-claims/:id), business-claims.service
// setea Business.ownerId + verified=true en una transaccion, y rechaza
// cualquier otra solicitud pendiente para el mismo negocio.
model BusinessClaim {
  id           String              @id @default(uuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation("BusinessClaimsMade", fields: [userId], references: [id])
  message      String?
  status       BusinessClaimStatus @default(PENDIENTE)
  reviewedById String?
  reviewedBy   User?               @relation("BusinessClaimsReviewed", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([businessId])
  @@index([status])
}

// Comentario generico: cuelga de un Post o de un Business (exactamente uno
// de los dos, validado en el servicio, no en el esquema). "rating" solo se
// usa cuando businessId esta presente: asi una review de negocio (seccion 5
// del brief, "Calificacion 4.6/5") es simplemente un comentario con
// puntaje, sin necesitar una tabla "reviews" separada.
model Comment {
  id         String    @id @default(uuid())
  content    String
  rating     Int?
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  postId     String?
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reports    Report[]
  hidden     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([postId])
  @@index([businessId])
}

enum ReactionType {
  LIKE
}

// Igual que Comment: exactamente uno de postId/businessId, validado en el
// servicio. Los @@unique evitan que un mismo usuario reaccione dos veces
// con el mismo tipo al mismo post/negocio (Postgres no compara NULLs como
// iguales, asi que cada indice solo restringe su propio caso).
model Reaction {
  id         String       @id @default(uuid())
  type       ReactionType @default(LIKE)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  postId     String?
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, businessId, type])
  @@index([postId])
  @@index([businessId])
}

enum ReportReason {
  SPAM
  INFORMACION_FALSA
  CONTENIDO_OFENSIVO
  OTRO
}

enum ReportStatus {
  PENDIENTE
  REVISADO
  DESESTIMADO
}

// Reporte generico: exactamente uno de postId/businessId/commentId,
// validado en el servicio. reviewedById/reviewedAt quedan null hasta que
// un moderador (User.isModerator) lo resuelve via PATCH /reports/:id.
model Report {
  id           String       @id @default(uuid())
  reason       ReportReason
  description  String?
  status       ReportStatus @default(PENDIENTE)
  reporterId   String
  reporter     User         @relation("ReportsMade", fields: [reporterId], references: [id])
  postId       String?
  post         Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  businessId   String?
  business     Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedBy   User?        @relation("ReportsReviewed", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status])
  @@index([postId])
  @@index([businessId])
  @@index([commentId])
}

// Foto generica: exactamente uno de postId/businessId (validado en el
// servicio, mismo patron que Comment/Reaction/Report). El archivo en si NO
// vive en Postgres — "url" apunta a un bucket S3-compatible (AWS real o
// self-hosted como MinIO, ver StorageService); aca solo se guarda el
// metadato. Ver ROADMAP.md para la config de storage.
model Photo {
  id           String    @id @default(uuid())
  url          String
  postId       String?
  post         Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([postId])
  @@index([businessId])
}

// Seguir a otro usuario (seccion 14 del brief). followerId sigue a
// followingId. El @@unique evita duplicados y hace de "ya lo sigo" un
// simple exists(); el toggle (seguir/dejar de seguir) vive en el servicio,
// igual que Reaction.
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// Guardado generico (posts o negocios favoritos, seccion 22 del brief:
// saved_places/saved_posts como una sola tabla). Mismo patron que
// Comment/Reaction/Report: exactamente uno de postId/businessId, validado
// en el servicio. Toggle igual que Reaction.
model SavedItem {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, postId])
  @@unique([userId, businessId])
  @@index([postId])
  @@index([businessId])
}
