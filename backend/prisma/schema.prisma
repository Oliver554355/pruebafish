generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  posts        Post[]
  businesses   Business[]
  comments     Comment[]
  reactions    Reaction[]
}

enum PostCategory {
  ACCIDENTE
  INCIDENTE
  ANIMAL_PERDIDO
  ANIMAL_ENCONTRADO
  ADOPCION
  RECOMENDACION
  EVENTO
  AVISO
  VENTA
  OTRO
}

// lat/lng son la fuente de verdad; la columna "geog" (geography(Point,4326))
// se agrega vía prisma/postgis-extensions.sql porque Prisma no modela tipos PostGIS.
model Post {
  id          String       @id @default(uuid())
  category    PostCategory
  title       String
  description String?
  lat         Float
  lng         Float
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  locationId  String?
  location    Location?    @relation(fields: [locationId], references: [id])
  comments    Comment[]
  reactions   Reaction[]
  createdAt   DateTime     @default(now())

  @@index([category])
  @@index([createdAt])
  @@index([locationId])
}

enum LocationType {
  PAIS
  REGION
  PROVINCIA
  DISTRITO
  ZONA
}

// Jerarquia geografica generica (Peru > Lima > Lima > Lurigancho-Chosica > Chosica)
// como una sola tabla auto-referenciada: agregar un distrito o ciudad nueva
// mas adelante es insertar una fila, no una migracion.
model Location {
  id        String       @id @default(uuid())
  type      LocationType
  name      String
  parentId  String?
  parent    Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children  Location[]   @relation("LocationHierarchy")
  posts     Post[]
  businesses Business[]
  createdAt DateTime     @default(now())

  @@index([parentId])
  @@index([type])
}

enum BusinessCategory {
  RESTAURANTE
  TIENDA
  HOSTAL
  PARQUE
  TURISMO
  FARMACIA
  SALUD
  EDUCACION
  BANCO_CAJERO
  PARADA
  OTRO
}

// Directorio de negocios/lugares. "geog" (geography(Point,4326) + indice
// GIST) se agrega en prisma/postgis-extensions.sql, igual que en Post.
// createdById es quien dio de alta el lugar (cualquier usuario, como en
// OSM/Google Maps) — no confundir con un futuro "owner" de negocio
// verificado (roadmap #9), que todavia no existe.
model Business {
  id          String           @id @default(uuid())
  category    BusinessCategory
  name        String
  description String?
  address     String?
  phone       String?
  hours       String?
  lat         Float
  lng         Float
  locationId  String?
  location    Location?        @relation(fields: [locationId], references: [id])
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  comments    Comment[]
  reactions   Reaction[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
  @@index([locationId])
}

// Comentario generico: cuelga de un Post o de un Business (exactamente uno
// de los dos, validado en el servicio, no en el esquema). "rating" solo se
// usa cuando businessId esta presente: asi una review de negocio (seccion 5
// del brief, "Calificacion 4.6/5") es simplemente un comentario con
// puntaje, sin necesitar una tabla "reviews" separada.
model Comment {
  id         String    @id @default(uuid())
  content    String
  rating     Int?
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  postId     String?
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([postId])
  @@index([businessId])
}

enum ReactionType {
  LIKE
}

// Igual que Comment: exactamente uno de postId/businessId, validado en el
// servicio. Los @@unique evitan que un mismo usuario reaccione dos veces
// con el mismo tipo al mismo post/negocio (Postgres no compara NULLs como
// iguales, asi que cada indice solo restringe su propio caso).
model Reaction {
  id         String       @id @default(uuid())
  type       ReactionType @default(LIKE)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  postId     String?
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, businessId, type])
  @@index([postId])
  @@index([businessId])
}
